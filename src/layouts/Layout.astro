---
interface Props {
  title: string;
}

const { title } = Astro.props;
const matomoSiteId = import.meta.env.PUBLIC_MATOMO_SITE_ID;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <script is:inline>
      (function () {
        // Set theme before paint to avoid flash
        const stored = localStorage.getItem("theme");
        if (stored) {
          document.documentElement.setAttribute("data-theme", stored);
        }
        // hehe
        var now = new Date();
        if (now.getMonth() === 3 && now.getDate() === 1) {
          var s = document.createElement("style");
          s.textContent = '@font-face { font-family: "Comic Sans Override"; src: url("/fonts/ComicSans.ttf") format("truetype"); font-display: swap; } body { font-family: "Comic Sans Override", "Comic Sans MS", cursive !important; }';
          document.head.appendChild(s);
        }
      })();
    </script>
    <script is:inline>
      // Background color that fades over 24h between 3 colors per theme
      (function () {
        var dark  = [[15,23,42],[0,1,3],[12,38,66]];
        var light = [[237,237,233],[245,235,224],[227,213,202]];

        function lerp(a, b, t) {
          return Math.round(a + (b - a) * t);
        }

        function toHex(r, g, b) {
          return "#" + ((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1);
        }

        function getColor(palette, hour, min) {
          var t = (hour + min / 60) / 24;
          var seg = t * 3;
          var i = Math.floor(seg) % 3;
          var f = seg - Math.floor(seg);
          var a = palette[i];
          var b = palette[(i + 1) % 3];
          return [lerp(a[0],b[0],f), lerp(a[1],b[1],f), lerp(a[2],b[2],f)];
        }

        function apply() {
          var now = new Date();
          var theme = document.documentElement.getAttribute("data-theme") || "dark";
          var palette = theme === "light" ? light : dark;
          var rgb = getColor(palette, now.getHours(), now.getMinutes());
          var hex = toHex(rgb[0], rgb[1], rgb[2]);
          document.documentElement.style.setProperty("--bg", hex);
          var el = document.getElementById("bg-hex");
          if (el) el.textContent = hex;
        }

        apply();
        document.addEventListener("DOMContentLoaded", apply);
        setInterval(apply, 60000);
        window.__applyBgColor = apply;
      })();
    </script>
    <script is:inline>
      // Midnight party mode -- 15s of vibrant color cycling at 00:00
      (function () {
        function msUntilMidnight() {
          var now = new Date();
          var midnight = new Date(now);
          midnight.setHours(24, 0, 0, 0);
          return midnight - now;
        }

        function startParty(duration) {
          var start = performance.now();
          var ms = duration * 1000;
          document.documentElement.classList.add("party-mode");

          function frame(ts) {
            var elapsed = ts - start;
            if (elapsed >= ms) {
              document.documentElement.classList.remove("party-mode");
              if (window.__applyBgColor) window.__applyBgColor();
              setTimeout(function () { startParty(15); }, msUntilMidnight());
              return;
            }
            var hue = (elapsed / 2000 * 360) % 360;
            var theme = document.documentElement.getAttribute("data-theme") || "dark";
            var l = theme === "light" ? "65%" : "25%";
            document.documentElement.style.setProperty("--bg", "hsl(" + hue + ", 100%, " + l + ")");
            requestAnimationFrame(frame);
          }

          requestAnimationFrame(frame);
        }

        var now = new Date();
        if (now.getHours() === 0 && now.getMinutes() === 0 && now.getSeconds() < 15) {
          startParty(15 - now.getSeconds());
        } else {
          setTimeout(function () { startParty(15); }, msUntilMidnight());
        }
      })();
    </script>
    <script is:inline>
      // Tooltips: tap to show on touch devices
      document.addEventListener("DOMContentLoaded", function () {
        document.addEventListener("click", function (e) {
          var target = e.target.closest("[data-tooltip]");
          document.querySelectorAll("[data-tooltip].tooltip-visible").forEach(function (el) {
            if (el !== target) el.classList.remove("tooltip-visible");
          });
          if (target) {
            target.classList.toggle("tooltip-visible");
          }
        });
      });
    </script>
    {matomoSiteId && (
      <script is:inline define:vars={{ matomoSiteId }}>
        var _paq = window._paq = window._paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function() {
          var u="https://analytics.dotreflection.com/";
          _paq.push(['setTrackerUrl', u+'matomo.php']);
          _paq.push(['setSiteId', matomoSiteId]);
          var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
          g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
        })();
      </script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
