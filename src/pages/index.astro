---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import CVEntry from "../components/CVEntry.astro";
import Photography from "../components/Photography.astro";
import Footer from "../components/Footer.astro";

import projects from "../data/projects.json";
import work from "../data/work.json";
import publications from "../data/publications.json";
import blog from "../data/blog.json";
import education from "../data/education.json";
import other from "../data/other.json";
---

<Layout title="Paul Goldschmidt">
  <div class="page-wrapper">
    <div class="appear" style="--delay: 0"><Header /></div>
    <Sidebar />

    <main>
      <p class="intro appear" style="--delay: 1">Hi!<br>I'm Paul, a developer, mechanical engineering student, (concert-)photographer and founder trying to solve problems around me and have some fun while doing it. I tried to give a little sneak peak into my life on this website and sort what I do on a daily basis. You can find me often either around the Bay Area or in Hamburg, Germany. Feel free to reach out for collabs or any remaining questions.<br>~Paul <i>(Last updated: April, 2026)</i></p>

      <!-- Projects -->
      <div class="appear" style="--delay: 2">
      <Section title="Projects" id="projects">
        {projects.map((p) => (
          <CVEntry label={p.year}>
            {p.image && <img class="project-img" src={p.image} alt={p.title} loading="lazy" data-lightbox data-subtitle={p.title} />}
            <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
            <p set:html={p.description} />
          </CVEntry>
        ))}
      </Section>
      </div>

      <!-- Work Experience -->
      <div class="appear" style="--delay: 3">
      <Section title="Work Experience" id="work">
        {work.map((w) => (
          <CVEntry label={w.years} sublabel={w.location}>
            <h3>{w.role} — {w.company}</h3>
            <p set:html={w.description} />
          </CVEntry>
        ))}
      </Section>
      </div>

      <!-- Publications -->
      <div class="appear" style="--delay: 4">
      <Section title="Publications" id="publications">
        {publications.map((p) => (
          <CVEntry label={p.year}>
            <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
            <p>{p.venue}</p>
          </CVEntry>
        ))}
      </Section>
      </div>

      <!-- Education -->
      <div class="appear" style="--delay: 5">
      <Section title="Education" id="education">
        {education.map((e) => (
          <CVEntry label={e.years}>
            <h3>{e.institution}</h3>
            <p>{e.degree}</p>
            {e.description && e.description.length > 0 && (
              <ul>
                {e.description.map((item: string) => <li set:html={item} />)}
              </ul>
            )}
          </CVEntry>
        ))}
      </Section>
      </div>

      <!-- Photography -->
      <div class="appear" style="--delay: 6">
      <Photography />
      </div>

      <!-- Blog -->
      <div class="appear" style="--delay: 7">
      <Section title="Recent Blog Posts" id="blog">
        {blog.map((b) => (
          <CVEntry label={b.year}>
            <h3>{b.url ? <a href={b.url}>{b.title}</a> : b.title}</h3>
            {b.excerpt && <p>{b.excerpt}</p>}
          </CVEntry>
        ))}
        <CVEntry label="">
          <p><a href="/blog">Find all posts on my blog ↗</a></p>
        </CVEntry>
      </Section>
      </div>

      <!-- Other Stuff -->
      <div class="appear" style="--delay: 8">
      <Section title="Other Stuff" id="other">
        {other.map((o) => (
          <CVEntry label={o.label}>
            {o.url ? <h3><a href={o.url} set:html={o.title} /></h3> : <h3 set:html={o.title} />}
            <p set:html={o.description} />
          </CVEntry>
        ))}
      </Section>
      </div>

      <!-- Colophon -->
      <div class="appear" style="--delay: 9">
      <Section title="Colophon" id="colophon">
        <CVEntry label="Stack">
          <p>Built with <a href="https://astro.build/">Astro</a>, styled with vanilla CSS, set in <a href="https://vercel.com/font">Geist Sans</a>.</p>
          <p>The background color of this page is currenly <span id="bg-hex"></span>.</p>
          <p>Theme inspired by <a href="https://github.com/robb/robb.is">Robb Böhnke</a>, rewritten using Astro.</p>
        </CVEntry>
        <CVEntry label="Hardware">
          <ul>
            <li>MacBook Pro 14-inch, Sep 2021, Apple M1 Max, 32 GB / 4 TB</li>
            <li>iPhone 17 Pro Max @ 512 GB</li>
            <li>Sony α7 III + Sony α7 IV (Tamron 28-75mm f2.8, Tamron 75-180mm f2.8, Sony FE 20mm F1.8, Sony FE 200–600 mm f5.6–6.3, Sony FE 90mm f2.8 Macro G, Samyang 50mm F1.4)</li>
            <li>ODROID-H2 Home Server with 2x 20TB Seagate Exos + 2x4TB M.2 SSD</li>
            <li>Dell UltraSharp U3224KBA, 31.5 Zoll</li>
          </ul>
        </CVEntry>
        <CVEntry label="Software">
          <p><a href="https://www.apple.com/de/os/macos/">MacOS (always somewhat on the latest release)</a></p>
          <p><a href="https://code.visualstudio.com">Visual Studio Code</a></p>
          <p><a href="https://www.warp.dev">Warp Terminal</a></p>
          <p><a href="https://www.adobe.com/en/creativecloud.html">Adobe Creative Cloud</a></p>
          <p><a href="https://slack.com">Slack</a></p>
          <p><a href="https://www.notion.com/">Notion</a></p>
          <p><a href="https://brew.sh">Homebrew</a></p>
          <p><a href="https://www.texifier.com">Texifier</a></p>
          <p><a href="https://www.autodesk.com/en/products/fusion-360/overview">Fusion 360</a></p>
        </CVEntry>
        <CVEntry label="Internal Links">
          <p><a href="/imprint">Imprint</a></p>
          <p><a href="/privacy-policy">Privacy Policy</a></p>
          <p><a href="/test">Test Link</a></p>
          <p><a href="/contact/paulgoldschmidt.vcf" download>Download vCard</a></p>
        </CVEntry>
      </Section>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
