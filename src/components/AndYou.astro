---
import Section from "./Section.astro";
import CVEntry from "./CVEntry.astro";
---

<Section title="And You?" id="and-you">
  <CVEntry label="">
    <p id="andyou-greeting"></p>
    <div id="andyou-input-area">
      <input type="text" id="andyou-input" placeholder="Tell me something about yourself..." maxlength="100" />
      <button id="andyou-submit">Go</button>
    </div>
    <div id="andyou-result" style="display:none">
      <p id="andyou-remembered"></p>
      <canvas id="andyou-constellation"></canvas>
      <button id="andyou-reset">Start over</button>
    </div>
  </CVEntry>
</Section>

<script is:inline>
  (function () {
    var greetings = [
      [5,  7,  "Early bird? The sun is just waking up."],
      [7,  9,  "Good morning! Coffee's brewing."],
      [9,  12, "Good morning! Hope your day's off to a great start."],
      [12, 13, "Lunch break browsing? Nice."],
      [13, 15, "Good afternoon! The day is in full swing."],
      [15, 17, "The golden hour is approaching."],
      [17, 19, "Good evening! The sky is painting itself."],
      [19, 21, "The blue hour. Everything looks better now."],
      [21, 23, "Night owl? You're in good company."],
      [23, 25, "Midnight thoughts. The best kind."],
      [1,  3,  "Still up? The world is quiet now."],
      [3,  5,  "The darkest hour. But dawn is coming."]
    ];

    function getGreeting() {
      var h = new Date().getHours();
      for (var i = 0; i < greetings.length; i++) {
        var start = greetings[i][0], end = greetings[i][1];
        if (end > 24 ? (h >= start || h < end - 24) : (h >= start && h < end))
          return greetings[i][2];
      }
      return greetings[0][2];
    }

    var CANVAS_W = 300, CANVAS_H = 200;
    var THRESHOLD_SQ = 100 * 100;

    function drawConstellation(text, canvas) {
      var ctx = canvas.getContext("2d");
      ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);

      var color = getComputedStyle(document.documentElement)
        .getPropertyValue("--text-tertiary").trim();

      var points = [];
      for (var i = 0; i < text.length; i++) {
        var c = text.charCodeAt(i);
        points.push([
          ((c * 7 + i * 131) % (CANVAS_W - 20)) + 10,
          ((c * 13 + i * 97) % (CANVAS_H - 20)) + 10
        ]);
      }

      ctx.strokeStyle = color;
      ctx.globalAlpha = 0.2;
      ctx.lineWidth = 1;
      for (var i = 0; i < points.length; i++) {
        for (var j = i + 1; j < points.length; j++) {
          var dx = points[i][0] - points[j][0];
          var dy = points[i][1] - points[j][1];
          if (dx * dx + dy * dy < THRESHOLD_SQ) {
            ctx.beginPath();
            ctx.moveTo(points[i][0], points[i][1]);
            ctx.lineTo(points[j][0], points[j][1]);
            ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = 1;
      ctx.fillStyle = color;
      for (var i = 0; i < points.length; i++) {
        ctx.beginPath();
        ctx.arc(points[i][0], points[i][1], 2.5, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    var greetingEl = document.getElementById("andyou-greeting");
    var inputArea = document.getElementById("andyou-input-area");
    var resultArea = document.getElementById("andyou-result");
    var input = document.getElementById("andyou-input");
    var submitBtn = document.getElementById("andyou-submit");
    var remembered = document.getElementById("andyou-remembered");
    var canvas = document.getElementById("andyou-constellation");
    var resetBtn = document.getElementById("andyou-reset");

    var dpr = window.devicePixelRatio || 1;
    canvas.width = CANVAS_W * dpr;
    canvas.height = CANVAS_H * dpr;
    canvas.style.width = CANVAS_W + "px";
    canvas.style.height = CANVAS_H + "px";
    canvas.getContext("2d").scale(dpr, dpr);

    var stored = localStorage.getItem("andyou-text");

    function showResult(text) {
      inputArea.style.display = "none";
      resultArea.style.display = "block";
      remembered.textContent = "In your words: \"" + text + "\"";
      drawConstellation(text, canvas);
    }

    if (stored) {
      greetingEl.textContent = getGreeting() + " Welcome back!";
      showResult(stored);
    } else {
      greetingEl.textContent = getGreeting();
    }

    submitBtn.addEventListener("click", function () {
      var text = input.value.trim();
      if (!text) return;
      localStorage.setItem("andyou-text", text);
      showResult(text);
    });

    input.addEventListener("keydown", function (e) {
      if (e.key === "Enter") submitBtn.click();
    });

    resetBtn.addEventListener("click", function () {
      localStorage.removeItem("andyou-text");
      resultArea.style.display = "none";
      inputArea.style.display = "block";
      input.value = "";
      greetingEl.textContent = getGreeting();
    });
  })();
</script>

<script>
  import { WebHaptics } from "web-haptics";
  const haptics = new WebHaptics();
  document.getElementById("andyou-submit")?.addEventListener("click", () => {
    haptics.trigger("medium");
  });
  document.getElementById("andyou-reset")?.addEventListener("click", () => {
    haptics.trigger("light");
  });
</script>

<style>
  #andyou-input {
    background: none;
    border: none;
    border-bottom: 1px solid var(--text-tertiary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.25rem 0;
    width: 70%;
    outline: none;
    transition: border-color 0.2s;
  }

  #andyou-input:focus {
    border-bottom-color: var(--accent);
  }

  #andyou-input::placeholder {
    color: var(--text-tertiary);
    opacity: 0.7;
  }

  #andyou-submit {
    background: none;
    border: 1px solid var(--text-tertiary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.75rem;
    margin-left: 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  #andyou-submit:hover {
    border-color: var(--accent);
  }

  #andyou-constellation {
    display: block;
    margin-top: 0.75rem;
    border-radius: 8px;
    max-width: 100%;
    height: auto;
  }

  #andyou-reset {
    background: none;
    border: none;
    color: var(--text-tertiary);
    font: inherit;
    font-size: 0.8rem;
    padding: 0;
    margin-top: 0.5rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  #andyou-reset:hover {
    color: var(--text-primary);
  }

  #andyou-remembered {
    color: var(--text-secondary);
    font-style: italic;
  }

  #andyou-greeting {
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  @media screen and (max-width: 799px) {
    #andyou-input {
      width: 60%;
    }
  }
</style>
