---
import Section from "./Section.astro";
import CVEntry from "./CVEntry.astro";
---

<Section title="And You?" id="and-you">
  <CVEntry label="">
    <p><span id="andyou-greeting"></span> <span id="andyou-intro"></span></p>
    <div id="andyou-input-area">
      <input type="text" id="andyou-input" placeholder="Tell me something about yourself..." maxlength="100" />
      <button id="andyou-submit">Go</button>
    </div>
    <div id="andyou-result" style="display:none">
      <canvas id="andyou-constellation"></canvas>
      <p id="andyou-remembered"></p>
      <button id="andyou-reset">Start over</button>
    </div>
  </CVEntry>
</Section>

<script>
  const greetings: [number, number, string[]][] = [
    [5,  7,  ["Early bird? Hoping you catch the worm.", "You're up before the coffee machine, huh?", "The world is still stretching. So are you."]],
    [7,  9,  ["Good morning! Coffee's brewing.", "Rise and shine \u2014 or at least rise.", "Morning!"]],
    [9,  12, ["Good morning! Hope your day's off to a great start.", "Mid-morning. The productive hours, they say.", "Hello! In the flow yet?"]],
    [12, 13, ["Lunch break? Nice.", "Noon already. Time flies.", "Midday pause \u2014 good time to browse."]],
    [13, 15, ["Good afternoon! The day is in full swing.", "Afternoon. That post-lunch energy hitting?", "Welcome to pt. 2 of today."]],
    [15, 19, ["Good evening! The sky is painting itself.", "The golden hour is approaching, better get out that camera.", "Winding down or just getting started?"]],
    [19, 21, ["The blue hour. Everything looks better now.", "Evening. The screen glows a little warmer (truetone not included).", "The day is settling. Nice to see you."]],
    [21, 23, ["Night owl? You're in good company.", "Late evening. The internet gets quieter now.", "Still going? Respect."]],
    [23, 25, ["Midnight thoughts, the best kind, I hope.", "The day just flipped. Fresh start energy for ya?", "Past midnight. Nothing good or everything good happens now, I guess."]],
    [1,  3,  ["Still up? The world is quiet now.", "The deep hours. Just you and the screen.", "Everyone else is asleep. Not you though."]],
    [3,  5,  ["The darkest hour. But dawn is coming.", "Almost sunrise. You made it this far.", "The birds will start soon. You beat them."]],
  ];

  function getGreeting(): string {
    const h = new Date().getHours();
    for (const [start, end, texts] of greetings) {
      if (end > 24 ? (h >= start || h < end - 24) : (h >= start && h < end))
        return texts[Math.floor(Math.random() * texts.length)];
    }
    return greetings[0][2][0];
  }

  function getVisitorInfo(): string {
    const ua = window.navigator.userAgent;
    const match = ua.match(/\(([^)]+)\)/);
    return match ? match[1] : ua;
  }

  const CANVAS_W = 300, CANVAS_H = 200;
  const THRESHOLD_SQ = 100 * 100;

  function drawConstellation(text: string, canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d")!;
    ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);

    const color = getComputedStyle(document.documentElement)
      .getPropertyValue("--text-tertiary").trim();

    const points: [number, number][] = [];
    for (let i = 0; i < text.length; i++) {
      const c = text.charCodeAt(i);
      points.push([
        ((c * 7 + i * 131) % (CANVAS_W - 20)) + 10,
        ((c * 13 + i * 97) % (CANVAS_H - 20)) + 10,
      ]);
    }

    ctx.strokeStyle = color;
    ctx.globalAlpha = 0.2;
    ctx.lineWidth = 1;
    for (let i = 0; i < points.length; i++) {
      for (let j = i + 1; j < points.length; j++) {
        const dx = points[i][0] - points[j][0];
        const dy = points[i][1] - points[j][1];
        if (dx * dx + dy * dy < THRESHOLD_SQ) {
          ctx.beginPath();
          ctx.moveTo(points[i][0], points[i][1]);
          ctx.lineTo(points[j][0], points[j][1]);
          ctx.stroke();
        }
      }
    }

    ctx.globalAlpha = 1;
    ctx.fillStyle = color;
    for (const [x, y] of points) {
      ctx.beginPath();
      ctx.arc(x, y, 2.5, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  const greetingEl = document.getElementById("andyou-greeting")!;
  const introEl = document.getElementById("andyou-intro")!;
  const inputArea = document.getElementById("andyou-input-area")!;
  const resultArea = document.getElementById("andyou-result")!;
  const input = document.getElementById("andyou-input") as HTMLInputElement;
  const submitBtn = document.getElementById("andyou-submit")!;
  const remembered = document.getElementById("andyou-remembered")!;
  const canvas = document.getElementById("andyou-constellation") as HTMLCanvasElement;
  const resetBtn = document.getElementById("andyou-reset")!;

  const dpr = window.devicePixelRatio || 1;
  canvas.width = CANVAS_W * dpr;
  canvas.height = CANVAS_H * dpr;
  canvas.style.width = CANVAS_W + "px";
  canvas.style.height = CANVAS_H + "px";
  canvas.getContext("2d")!.scale(dpr, dpr);

  const stored = localStorage.getItem("andyou-text");
  const visitorInfo = getVisitorInfo();

  function showResult(text: string) {
    inputArea.style.display = "none";
    resultArea.style.display = "block";
    remembered.textContent = `In your words: "${text}"`;
    drawConstellation(text, canvas);
  }

  function setFirstVisitIntro() {
    introEl.textContent = `I feel like I already told enough about me \u2014 if you want to, tell the stars (you will see why) about yourself, because the only thing I know about you is that you're a ${visitorInfo}. So please, go wild:`;
  }

  if (stored) {
    greetingEl.textContent = getGreeting() + " Welcome back!";
    introEl.textContent = `I feel like I already told enough about me \u2014 if you want to, tell the stars about yourself, because the only thing I know about you is that you're a ${visitorInfo}. Here's what you told me about yourself last time:`;
    showResult(stored);
  } else {
    greetingEl.textContent = getGreeting();
    setFirstVisitIntro();
  }

  submitBtn.addEventListener("click", () => {
    const text = input.value.trim();
    if (!text) return;
    localStorage.setItem("andyou-text", text);
    showResult(text);
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") submitBtn.click();
  });

  resetBtn.addEventListener("click", () => {
    localStorage.removeItem("andyou-text");
    resultArea.style.display = "none";
    inputArea.style.display = "block";
    input.value = "";
    greetingEl.textContent = getGreeting();
    setFirstVisitIntro();
  });
</script>

<style>
  #andyou-input {
    background: none;
    border: none;
    border-bottom: 1px solid var(--text-tertiary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.25rem 0;
    width: 70%;
    outline: none;
    transition: border-color 0.2s;
  }

  #andyou-input:focus {
    border-bottom-color: var(--accent);
  }

  #andyou-input::placeholder {
    color: var(--text-tertiary);
    opacity: 0.7;
  }

  #andyou-submit {
    background: none;
    border: 1px solid var(--text-tertiary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.75rem;
    margin-left: 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  #andyou-submit:hover {
    border-color: var(--accent);
  }

  #andyou-constellation {
    display: block;
    margin-top: 0.75rem;
    border-radius: 8px;
    max-width: 100%;
    height: auto;
  }

  #andyou-reset {
    background: none;
    border: none;
    color: var(--text-tertiary);
    font: inherit;
    font-size: 0.8rem;
    padding: 0;
    margin-top: 0.5rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  #andyou-reset:hover {
    color: var(--text-primary);
  }

  #andyou-remembered {
    color: var(--text-secondary);
    font-style: italic;
  }

  #andyou-greeting,
  #andyou-intro {
    color: var(--text-secondary);
  }

  @media screen and (max-width: 799px) {
    #andyou-input {
      width: 60%;
    }
  }
</style>
