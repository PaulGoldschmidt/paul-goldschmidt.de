---
const navItems = [
  { href: "#projects", label: "Projects" },
  { href: "#work", label: "Work Experience" },
  { href: "#publications", label: "Publications" },
  { href: "#photography", label: "Photography" },
  { href: "#blog", label: "Blog" },
  { href: "#education", label: "Education" },
  { href: "#other", label: "Other Stuff" },
  { href: "#colophon", label: "Colophon" },
];
---

<header class="site-header">
  <div class="header-top">
    <a href="/contact/paulgoldschmidt.vcf" download class="vcard" id="vcard-link">
      <img class="avatar" src="/img/profile/paulgoldschmidt-header.jpg" alt="Paul Goldschmidt" width="44" height="44" />
      <div>
        <h1>Paul Goldschmidt</h1>
        <span class="subtitle">Programmer & student, human being</span>
      </div>
    </a>
  </div>
  <nav class="inline-nav">
    <span class="inline-nav-label">Here</span>
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <span class="inline-nav-separator" aria-hidden="true"></span>
    <span class="inline-nav-label">Elsewhere</span>
    <a href="mailto:kontakt@paul-goldschmidt.de">Email</a>
    <a href="https://github.com/paulgoldschmidt">GitHub</a>
    <a href="https://www.instagram.com/_paulgoldschmidt/">Instagram</a>
    <a href="https://www.linkedin.com/in/paul-goldschmidt/">LinkedIn</a>
    <a href="https://twitter.com/pauIgoldschmidt">X</a>
    <span class="inline-nav-label">or</span>
    <a href="mailto:presse@paul-goldschmidt.de">Press Contact</a>
  </nav>
</header>

<script is:inline>
  // Only allow vCard download on touch devices, tbh somewhat hacky here (you can still see the link) but works fine on my machine hehe
  document.addEventListener("DOMContentLoaded", function () {
    var link = document.getElementById("vcard-link");
    if (!link) return;
    if (!("ontouchstart" in window)) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
      });
    }
  });
</script>

<script>
  import { WebHaptics } from "web-haptics";
  const haptics = new WebHaptics();
  document.querySelector(".avatar")?.addEventListener("click", () => {
    haptics.trigger("medium");
  });
</script>

<style>
  .inline-nav-separator {
    width: 100%;
    height: 0;
  }
  a.vcard {
    color: inherit;
    text-decoration: none;
    cursor: default;
  }

  @media (pointer: coarse) {
    a.vcard {
      cursor: pointer;
    }
  }

  a.vcard::after {
    content: none;
  }

  .inline-nav-label {
    color: var(--text-tertiary);
    font-size: 0.875rem;
    font-style: italic;
  }
</style>
