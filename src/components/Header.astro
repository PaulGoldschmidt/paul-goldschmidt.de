---
const navItems = [
  { href: "#projects", label: "Projects" },
  { href: "#work", label: "Work Experience" },
  { href: "#publications", label: "Publications" },
  { href: "#photography", label: "Photography" },
  { href: "#blog", label: "Blog" },
  { href: "#education", label: "Education" },
  { href: "#other", label: "Other Stuff" },
  { href: "#colophon", label: "Colophon" },
];
---

<header class="site-header">
  <div class="header-top">
    <div class="vcard">
      <div class="avatar" aria-hidden="true"></div>
      <div>
        <h1>Paul Goldschmidt</h1>
        <span class="subtitle">Developer based in Germany.</span>
      </div>
    </div>
  </div>
  <nav class="inline-nav">
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <span class="inline-nav-separator" aria-hidden="true"></span>
    <a href="mailto:kontakt@paul-goldschmidt.de">Email</a>
    <a href="mailto:presse@paul-goldschmidt.de">Press</a>
    <a href="https://www.linkedin.com/in/paul-goldschmidt/">LinkedIn</a>
    <a href="https://twitter.com/pauIgoldschmidt">X</a>
  </nav>
</header>

<style>
  .inline-nav-separator {
    width: 100%;
    height: 0;
  }
</style>
