---
import photos from "../data/photography.json";
---

<section class="section">
  <h2 id="photography">Photography</h2>
  <div class="photo-grid">
    {photos.map((photo) => (
      <img
        src={photo.src}
        alt={photo.alt}
        title={photo.title || ""}
        data-subtitle={photo.subtitle || ""}
        loading="lazy"
        data-lightbox
        class:list={[{ "photo-wide": photo.wide }]}
      />
    ))}
  </div>
  <p class="photo-note">More pictures can be found in my <a href="https://photos.paul-goldschmidt.de/gallery#o0A4UBnMbnB3mwyM9vDtjPI2">personal gallery</a> and all of my concert shots have their <a href="https://goldschmidtphoto.com/">seperate website</a>!</p>
</section>

<!-- Lightbox overlay -->
<div class="lightbox" id="lightbox" role="dialog" aria-label="Photo viewer">
  <div class="lightbox-content">
    <img src="" alt="" />
    <p class="lightbox-subtitle"></p>
  </div>
</div>

<script is:inline>
  (function () {
    var lightbox = document.getElementById("lightbox");
    if (!lightbox) return;
    var lightboxImg = lightbox.querySelector("img");
    var lightboxSub = lightbox.querySelector(".lightbox-subtitle");

    document.querySelectorAll("[data-lightbox]").forEach(function (img) {
      img.addEventListener("click", function () {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        var sub = img.getAttribute("data-subtitle") || "";
        lightboxSub.textContent = sub;
        lightboxSub.style.display = sub ? "block" : "none";
        lightbox.classList.add("active");
      });
    });

    lightbox.addEventListener("click", function (e) {
      if (e.target === lightboxImg || e.target === lightboxSub) return;
      lightbox.classList.remove("active");
      lightboxImg.src = "";
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && lightbox.classList.contains("active")) {
        lightbox.classList.remove("active");
        lightboxImg.src = "";
      }
    });
  })();
</script>
